# ── server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Paste your MongoDB Atlas connection string here.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/linkvault?retryWrites=true&w=majority

# Public base URL used when building short links and blocking self-referencing URLs.
# Local dev: http://localhost:3000
# Render:    https://linkvault.onrender.com
HOST=http://localhost:3000
